def init_db():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    # جدول المنتجات والمزادات
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS products (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            title TEXT,
            price TEXT,
            quantity TEXT,
            description TEXT,
            is_auction INTEGER,
            current_bid TEXT,
            max_price TEXT,
            auction_end TEXT,
            contact_type TEXT,
            contact_value TEXT,
            images TEXT,
            is_sold INTEGER
        )
    ''')
    
    # جدول الإعدادات العامة والمتغيرات
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS settings (
            key TEXT PRIMARY KEY,
            value TEXT
        )
    ''')
    conn.commit()
    conn.close()

init_db()

def get_db_connection():
    conn = sqlite3.connect(DB_NAME)
    conn.row_factory = sqlite3.Row
    return conn

